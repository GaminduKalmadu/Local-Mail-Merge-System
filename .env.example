# Copy this file to .env for local development. Never commit the populated .env file.
LETTER_EMAIL_ENABLED=false
# Use immediate for the existing one-run workflow, or daily for a limited daily job.
LETTER_BATCH_MODE=immediate
# Keep false to prepare/review a daily job without sending. Set true and restart to trigger day one.
LETTER_DAILY_SEND_ENABLED=false
LETTER_DAILY_LIMIT=100
LETTER_DAILY_ZONE_ID=Asia/Colombo
LETTER_DAILY_POLL_DELAY_MS=60000
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=your-dedicated-sender@gmail.com
# Create an App Password after enabling Google 2-Step Verification.
GMAIL_APP_PASSWORD=

# Blank sends to each row's email column. Set your own address to redirect all mail during testing.
LETTER_EMAIL_TEST_RECIPIENT=
LETTER_EMAIL_SUBJECT=Your letter
LETTER_EMAIL_BODY=Dear {name}, please find your {letterType} letter attached.
